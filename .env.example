# 楽天ウェブサービス (https://webservice.rakuten.co.jp/) でアプリ登録して取得
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# アプリ登録時に許可したサイト URL (例: https://hikaku-mcpapp.onrender.com)
RAKUTEN_REFERER=
# 任意: アフィリエイト ID
RAKUTEN_AFFILIATE_ID=
# 任意: エンドポイントを上書きする場合
# RAKUTEN_ENDPOINT=https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20220601

# Yahoo!デベロッパーネットワーク (https://e.developer.yahoo.co.jp/) の Client ID
YAHOO_APP_ID=
# 任意: バリューコマースのアフィリエイト ID
YAHOO_AFFILIATE_ID=

# 設定すると /mcp/<トークン> でのみ受け付ける (推奨: 長いランダム文字列)
MCP_PATH_TOKEN=
# 1 にすると API キー無しで UI を確認できるダミーデータを返す
DEMO_MODE=
PORT=3001
